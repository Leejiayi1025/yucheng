# 语程 后端环境变量示例
# 复制为 .env 后填入本机 MySQL 实际信息
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yuecheng

# JWT 签名密钥（生产环境请改为随机长字符串）
JWT_SECRET=change_this_to_a_long_random_secret

# 邮件服务（Resend 方式，线上推荐；MAIL_API_URL 配了就优先走 API）
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=re_你的ResendKey
MAIL_FROM=语程 <no-reply@你的域名>

# 备用：QQ 邮箱 SMTP（本地开发用；未配 MAIL_API_URL 时生效）
# MAIL_SMTP_HOST=smtp.qq.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_USER=你的邮箱@qq.com
# MAIL_SMTP_PASS=授权码（不是登录密码）

# DeepSeek（语音语义解析）
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-你的DeepSeekKey
# 可选：deepseek-chat（快、便宜）或 deepseek-reasoner（推理强、慢且贵）
DEEPSEEK_MODEL=deepseek-chat

# AssemblyAI（实时语音识别）。
# 注意：这个 Key 只在服务端使用 —— 后端用它换一次性临时令牌（120 秒有效）再下发给前端，
# 前端拿不到永久密钥。不配的话语音识别接口会返回 503，前端会自动降级到浏览器识别。
ASSEMBLYAI_API_KEY=你的AssemblyAIKey

# 跨域白名单（逗号分隔）。线上前端域名和本地开发端口已内置默认值，一般不用填；
# 换了域名或加了 Netlify 预览环境时在这里追加
# CORS_ORIGINS=https://你的域名.netlify.app
