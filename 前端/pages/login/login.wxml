<view class="login-wrap" style="{{themeStyle}}">
  <view class="login-hero">
    <view class="login-logo"></view>
    <view class="login-name">语程</view>
    <view class="login-slogan">说一句话，安排好每一天</view>
  </view>

  <view class="login-card">
    <view class="seg">
      <view class="seg-item {{mode==='login'?'on':''}}" bindtap="setMode" data-m="login">登录</view>
      <view class="seg-item {{mode==='register'?'on':''}}" bindtap="setMode" data-m="register">注册</view>
    </view>

    <view wx:if="{{mode==='register'}}" class="lf">
      <label>昵称</label>
      <input value="{{nickname}}" maxlength="12" placeholder="给自己起个名字" bindinput="onNick" />
    </view>
    <view class="lf">
      <label>手机号</label>
      <input value="{{phone}}" type="number" maxlength="11" placeholder="11 位手机号" bindinput="onPhone" />
    </view>
    <view class="lf">
      <label>密码</label>
      <input value="{{password}}" password placeholder="至少 6 位" bindinput="onPwd" />
    </view>

    <button class="login-btn" bindtap="submit">{{mode==='login'?'登录':'注册并登录'}}</button>
    <view class="login-tip">演示种子账号：13800138000 / 123456</view>
  </view>
</view>
