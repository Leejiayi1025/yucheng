<view class="page-wrap" style="{{themeStyle}}">
  <view class="topbar"><view class="tb-title">日历</view></view>

  <view class="cal-board">
    <view class="cb-row">
      <text class="cb-pill">本周 <text class="cb-num">{{weekDone}}/{{weekTotal}}</text></text>
      <text class="cb-pill">连续 {{streak}} 天</text>
      <text class="cb-pill">累计 {{total}}</text>
    </view>
  </view>

  <view class="cal-tabs">
    <view class="cal-tab {{view==='day'?'on':''}}" bindtap="switchView" data-v="day">日</view>
    <view class="cal-tab {{view==='week'?'on':''}}" bindtap="switchView" data-v="week">周</view>
    <view class="cal-tab {{view==='month'?'on':''}}" bindtap="switchView" data-v="month">月</view>
  </view>

  <view class="content">
    <!-- 日视图 -->
    <view wx:if="{{view==='day'}}">
      <view class="month-nav">
        <view class="mn-btn" bindtap="stepDay" data-d="-1">‹</view>
        <view class="mn-title">{{dayTitle}}</view>
        <view class="mn-btn" bindtap="stepDay" data-d="1">›</view>
      </view>
      <view wx:if="{{dayBackShow}}" class="month-back" bindtap="backToToday">回到今天</view>
      <view wx:if="{{dayTimed.length===0 && dayTodos.length===0}}" class="empty-hint">这天还没有安排</view>
      <view wx:for="{{dayTimed}}" wx:key="id" class="event-card {{item.status===1?'done':''}}" data-id="{{item.id}}" bindtap="openEdit">
        <view class="ev-check {{item.status===1?'on':''}}" catchtap="toggleDone" data-id="{{item.id}}"><view class="check-ic"></view></view>
        <view class="event-info">
          <view class="event-title">{{item.title}}</view>
          <view class="event-meta"><view wx:if="{{item.remind>=0}}" class="bell-ic"></view><text>{{item.start}}<text wx:if="{{item.end}}"> - {{item.end}}</text></text><text wx:if="{{item.place}}"> · {{item.place}}</text></view>
          <view wx:if="{{item.note}}" class="card-note">{{item.note}}</view>
        </view>
        <view class="event-tag" style="background:{{item.catBg}};color:{{item.catFg}}">{{item.cat}}</view>
      </view>
      <view wx:for="{{dayTodos}}" wx:key="id" class="todo-item {{item.status===1?'done':''}}" data-id="{{item.id}}" bindtap="openEdit">
        <view class="todo-check {{item.status===1?'on':''}}" catchtap="toggleDone" data-id="{{item.id}}"><view class="check-ic"></view></view>
        <view class="todo-body"><view class="todo-text">{{item.title}}</view><view wx:if="{{item.note}}" class="card-note">{{item.note}}</view></view>
      </view>
      <view class="cal-add" bindtap="openNewDay">＋ 在 {{dayShort}} 添加</view>
    </view>

    <!-- 周视图 -->
    <view wx:if="{{view==='week'}}">
      <view class="month-nav">
        <view class="mn-btn" bindtap="stepWeek" data-d="-1">‹</view>
        <view class="mn-title">{{weekRange}}</view>
        <view class="mn-btn" bindtap="stepWeek" data-d="1">›</view>
      </view>
      <view wx:if="{{weekBackShow}}" class="month-back" bindtap="backToThisWeek">回到本周</view>
      <view wx:for="{{weekDays}}" wx:key="ds" class="wk-day">
        <view class="wk-head {{item.isToday?'today':''}} {{item.ds===selDs?'sel':''}}" data-ds="{{item.ds}}" bindtap="pickDay">
          <text class="wk-w">{{item.w}}</text><text class="wk-d">{{item.day}}</text>
        </view>
        <view wx:if="{{item.tasks.length===0}}" class="wk-empty">—</view>
        <view wx:for="{{item.tasks}}" wx:for-item="t" wx:key="id" class="wk-task" data-id="{{t.id}}" bindtap="openEdit">
          <text class="wk-dot" style="background:{{t.catBg}}"></text>
          <text class="wk-t {{t.status===1?'done':''}}">{{t.start? t.start+' ':''}}{{t.title}}</text>
        </view>
      </view>
    </view>

    <!-- 月视图 -->
    <view wx:if="{{view==='month'}}">
      <view class="month-nav">
        <view class="mn-btn" bindtap="prevMonth">‹</view>
        <view class="mn-title">{{monthTitle}}</view>
        <view class="mn-btn" bindtap="nextMonth">›</view>
      </view>
      <view wx:if="{{monthBackShow}}" class="month-back" bindtap="backToThisMonth">回到本月</view>
      <view class="mg-head"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this" class="mg-h">{{item}}</text></view>
      <view class="mg-grid">
        <view wx:for="{{monthCells}}" wx:key="key" class="mg-cell {{item.other?'other':''}} {{item.isToday?'today':''}} {{item.ds===selDs?'sel':''}}" data-ds="{{item.ds}}" bindtap="pickDay">
          <text class="mg-d">{{item.day}}</text>
          <view wx:if="{{item.hasTask}}" class="mg-dot"></view>
        </view>
      </view>
      <view class="mg-daylist">
        <view class="sec-title"><text class="st-left">{{monthSelLabel}} <text class="count">{{monthSelTasks.length}}</text></text></view>
        <view wx:if="{{monthSelTasks.length===0}}" class="empty-hint">这一天还没有安排</view>
        <view wx:for="{{monthSelTasks}}" wx:key="id" class="event-card {{item.status===1?'done':''}}" data-id="{{item.id}}" bindtap="openEdit">
          <view class="ev-check {{item.status===1?'on':''}}" catchtap="toggleDone" data-id="{{item.id}}"><view class="check-ic"></view></view>
          <view class="event-info">
            <view class="event-title">{{item.title}}</view>
            <view class="event-meta"><text>{{item.start? item.start+(item.end?(' - '+item.end):'') : '待办'}}</text><text wx:if="{{item.place}}"> · {{item.place}}</text></view>
            <view wx:if="{{item.note}}" class="card-note">{{item.note}}</view>
          </view>
          <view class="event-tag" style="background:{{item.catBg}};color:{{item.catFg}}">{{item.cat}}</view>
        </view>
      </view>
    </view>
  </view>

  <edit-sheet visible="{{editVisible}}" mode="{{editMode}}" taskType="{{editTaskType}}" defaultDate="{{editDefaultDate}}" task="{{editTask}}" categories="{{categories}}"
    bind:save="onEditSave" bind:delete="onEditDelete" bind:close="onEditClose" bind:newcat="onNewCat" />
</view>
