.topbar { padding: env(safe-area-inset-top) 28rpx 8rpx; }
.tb-title { font-size: 40rpx; font-weight: 800; color: var(--text); }

.cal-board { padding: 8rpx 28rpx 4rpx; }
.cb-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.cb-pill { font-size: 24rpx; color: var(--text2); background: var(--card); border-radius: 20rpx; padding: 12rpx 18rpx; }
.cb-num { color: var(--primary); font-weight: 700; }

.cal-tabs { display: flex; gap: 12rpx; padding: 16rpx 28rpx; }
.cal-tab { flex: 1; text-align: center; padding: 18rpx 0; border-radius: var(--radius); background: var(--card); color: var(--text2); font-size: 28rpx; border: 1rpx solid var(--line); }
.cal-tab.on { background: var(--primary); color: #fff; font-weight: 700; }

.content { padding: 8rpx 28rpx 170rpx; }

.month-nav { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0 18rpx; }
.mn-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--card); display: flex; align-items: center; justify-content: center; color: var(--text); font-size: 36rpx; border: 1rpx solid var(--line); }
.mn-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.month-back { text-align: right; color: var(--primary); font-size: 24rpx; padding-bottom: 12rpx; }

/* 日视图复用卡片 */
.event-card { display: flex; align-items: center; gap: 16rpx; background: var(--card); border-radius: var(--radius); padding: 22rpx 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); border: 1rpx solid rgba(255,255,255,.5); }
.event-card.done .event-title { text-decoration: line-through; color: var(--text2); }
.ev-check, .todo-check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 2rpx solid var(--line); background: var(--solid); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ev-check.on, .todo-check.on { background: var(--primary); border-color: var(--primary); }
.check-ic { width: 26rpx; height: 26rpx; background-color: #fff; opacity: 0; -webkit-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z'/></svg>") no-repeat center / 26rpx 26rpx; mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z'/></svg>") no-repeat center / 26rpx 26rpx; }
.ev-check.on .check-ic, .todo-check.on .check-ic { opacity: 1; }
.event-info { flex: 1; min-width: 0; }
.event-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.event-meta { font-size: 24rpx; color: var(--text2); margin-top: 6rpx; display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.bell-ic { width: 24rpx; height: 24rpx; background-color: var(--text2); flex-shrink: 0; -webkit-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M18 8a6 6 0 0 0-12 0c0 6-2 7-2 7h16s-2-1-2-7'/><path fill='black' d='M10.5 20a2 2 0 0 0 3 0'/></svg>") no-repeat center / 24rpx 24rpx; mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M18 8a6 6 0 0 0-12 0c0 6-2 7-2 7h16s-2-1-2-7'/><path fill='black' d='M10.5 20a2 2 0 0 0 3 0'/></svg>") no-repeat center / 24rpx 24rpx; }
.event-tag { flex-shrink: 0; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 16rpx; font-weight: 600; }
.todo-item { display: flex; align-items: center; gap: 16rpx; background: var(--card); border-radius: var(--radius); padding: 22rpx 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); border: 1rpx solid rgba(255,255,255,.5); }
.todo-item.done .todo-text { text-decoration: line-through; color: var(--text2); }
.todo-body { flex: 1; min-width: 0; }
.todo-text { font-size: 30rpx; font-weight: 600; color: var(--text); }
.cal-add { margin-top: 16rpx; text-align: center; color: var(--primary); font-size: 28rpx; padding: 22rpx; background: var(--primary-soft); border-radius: var(--radius); }

/* 周视图 */
.wk-day { background: var(--card); border-radius: var(--radius); padding: 14rpx 18rpx; margin-bottom: 14rpx; }
.wk-head { display: inline-flex; align-items: baseline; gap: 8rpx; padding: 6rpx 12rpx; border-radius: 16rpx; margin-bottom: 8rpx; }
.wk-head.today { background: var(--primary-soft); }
.wk-head.sel { outline: 2rpx solid var(--primary); }
.wk-w { font-size: 22rpx; color: var(--text2); }
.wk-d { font-size: 30rpx; font-weight: 700; color: var(--text); }
.wk-empty { color: var(--text2); font-size: 24rpx; padding: 6rpx 12rpx; }
.wk-task { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 12rpx; }
.wk-dot { width: 18rpx; height: 18rpx; border-radius: 50%; flex-shrink: 0; }
.wk-t { font-size: 26rpx; color: var(--text); }
.wk-t.done { text-decoration: line-through; color: var(--text2); }

/* 月视图 */
.mg-head { display: flex; }
.mg-h { flex: 1; text-align: center; font-size: 22rpx; color: var(--text2); padding: 8rpx 0; }
.mg-grid { display: flex; flex-wrap: wrap; background: var(--card); border-radius: var(--radius); padding: 8rpx; margin-bottom: 20rpx; }
.mg-cell { width: 14.28%; height: 92rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.mg-cell.other { opacity: .35; }
.mg-cell.today .mg-d { color: var(--primary); font-weight: 800; }
.mg-cell.sel { background: var(--primary-soft); border-radius: 16rpx; }
.mg-d { font-size: 28rpx; color: var(--text); }
.mg-dot { position: absolute; bottom: 12rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--primary); }
.mg-daylist { margin-top: 8rpx; }
