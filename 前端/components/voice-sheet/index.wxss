.voice-card { max-height: 90vh; }
.vm-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.vm-title { font-size: 32rpx; font-weight: 700; color: var(--text); }
.vm-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; color: var(--text2); font-size: 34rpx; }

.vm-summary { display: flex; align-items: center; gap: 18rpx; background: var(--primary-soft); border-radius: var(--radius); padding: 20rpx 22rpx; margin-bottom: 18rpx; }
.vm-sum-dot { width: 28rpx; height: 28rpx; border-radius: 50%; flex-shrink: 0; }
.vm-sum-main { flex: 1; min-width: 0; }
.vm-sum-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.vm-sum-meta { font-size: 24rpx; color: var(--text2); margin-top: 4rpx; }
.vm-sum-edit { color: var(--primary); font-size: 26rpx; flex-shrink: 0; }

.vm-form { margin-bottom: 10rpx; }
.vm-f { margin-bottom: 18rpx; }
.vm-f > label { display: block; font-size: 24rpx; color: var(--text2); margin-bottom: 10rpx; }
.vm-actions { display: flex; gap: 18rpx; margin-top: 8rpx; }
.vm-cancel, .vm-add { flex: 1; height: 88rpx; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; border: none; }
.vm-cancel { background: var(--solid); color: var(--text2); border: 1rpx solid var(--line); }
.vm-add { background: var(--primary); color: #fff; }
.vm-cancel::after, .vm-add::after { border: none; }

.vm-text { width: 100%; height: 150rpx; background: var(--solid); border: 1rpx solid var(--line); border-radius: var(--radius); padding: 20rpx 22rpx; font-size: 28rpx; color: var(--text); }
.vm-samples { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 18rpx 0; }
.vm-sample { font-size: 23rpx; color: var(--primary-dark); background: var(--primary-soft); border-radius: 20rpx; padding: 10rpx 18rpx; }
.vm-bottom { display: flex; align-items: center; gap: 20rpx; }
.vm-mic { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 36rpx rgba(107,142,123,.35); flex-shrink: 0; }
.vm-mic.rec { animation: micPulse 1s infinite; }
@keyframes micPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }
.mic-ic { width: 44rpx; height: 44rpx; background-color: #fff; -webkit-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z'/><path fill='black' d='M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z'/></svg>") no-repeat center / 44rpx 44rpx; mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z'/><path fill='black' d='M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z'/></svg>") no-repeat center / 44rpx 44rpx; }
.vm-parse { flex: 1; height: 92rpx; background: var(--primary); color: #fff; border-radius: var(--radius); font-size: 30rpx; font-weight: 600; border: none; display: flex; align-items: center; justify-content: center; }
.vm-parse::after { border: none; }
