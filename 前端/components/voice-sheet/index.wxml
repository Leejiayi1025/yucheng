<view wx:if="{{visible}}">
  <view class="sheet-mask" bindtap="onClose"></view>
  <view class="sheet-card voice-card">
    <view class="vm-head">
      <view class="vm-title">说一句话，添加任务</view>
      <view class="vm-close" bindtap="onClose">✕</view>
    </view>

    <view wx:if="{{showSummary}}" class="vm-summary">
      <view class="vm-sum-dot" style="background:{{draftCatColor}}"></view>
      <view class="vm-sum-main">
        <view class="vm-sum-title">{{draft.title}}</view>
        <view class="vm-sum-meta">{{draftMeta}}</view>
      </view>
      <view class="vm-sum-edit" bindtap="toggleForm">{{showForm ? '收起' : '编辑'}}</view>
    </view>

    <view wx:if="{{showForm}}" class="vm-form">
      <view class="vm-f"><label>标题</label><input value="{{fTitle}}" maxlength="15" bindinput="onFTitle" /></view>
      <view class="vm-f"><label>日期</label>
        <picker mode="date" value="{{fDate}}" bindchange="onFDate">
          <view class="rm-sel picker-trigger"><text>{{fDateLabel}}</text><view class="rm-chev"></view></view>
        </picker>
      </view>
      <view wx:if="{{fHasTime}}" class="vm-f"><label>开始</label>
        <picker mode="time" value="{{fStart}}" bindchange="onFStart">
          <view class="rm-sel picker-trigger"><text>{{fStart || '选择'}}</text><view class="rm-chev"></view></view>
        </picker>
      </view>
      <view wx:if="{{fHasTime}}" class="vm-f"><label>结束</label>
        <picker mode="time" value="{{fEnd}}" bindchange="onFEnd">
          <view class="rm-sel picker-trigger"><text>{{fEnd || '选择'}}</text><view class="rm-chev"></view></view>
        </picker>
      </view>
      <view class="vm-f"><label>地点</label><input value="{{fPlace}}" maxlength="15" bindinput="onFPlace" /></view>
      <view class="vm-f"><label>分类</label>
        <rm-select options="{{catOptions}}" value="{{fCat}}" bind:change="onFCat" bind:custom="onNewCat" />
      </view>
      <view class="vm-actions">
        <button class="vm-cancel" bindtap="resetAll">重输</button>
        <button class="vm-add" bindtap="onAdd">添加任务</button>
      </view>
    </view>

    <view wx:if="{{!showSummary}}">
      <textarea class="vm-text" value="{{text}}" placeholder="例如：明天下午4点到7点学习PM理论知识" bindinput="onText" />
      <view class="vm-samples">
        <view wx:for="{{samples}}" wx:key="*this" class="vm-sample" data-t="{{item}}" bindtap="useSample">{{item}}</view>
      </view>
      <view class="vm-bottom">
        <view class="vm-mic {{recording ? 'rec' : ''}}" bindtap="toggleRecord"><view class="mic-ic"></view></view>
        <button class="vm-parse" bindtap="parse">解析文本</button>
      </view>
    </view>
  </view>
</view>
