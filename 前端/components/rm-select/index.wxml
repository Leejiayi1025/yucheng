<view class="rm-wrap">
  <view class="rm-trigger rm-sel {{open?'open':''}}" bindtap="onTrigger">
    <text class="rm-trigger-t">{{displayLabel}}</text>
    <view class="rm-chev"></view>
  </view>

  <view wx:if="{{open}}" class="rm-mask" bindtap="onMask"></view>

  <view wx:if="{{open}}" class="rm-pop" style="top:{{menuTop}}px;left:{{menuLeft}}px;min-width:{{menuWidth}}px;">
    <view wx:for="{{options}}" wx:key="value"
          class="rm-pop-opt {{item.value===value?'active':''}} {{item.special?'special':''}}"
          data-index="{{index}}" bindtap="onSelect">
      <view wx:if="{{item.color}}" class="rm-dot" style="background:{{item.color}}"></view>
      <text class="rm-pop-label">{{item.label}}</text>
      <text wx:if="{{item.value===value}}" class="rm-check">✓</text>
    </view>
  </view>
</view>
