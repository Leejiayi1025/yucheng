<view class="page-wrap" style="{{themeStyle}}">
  <view class="topbar"><view class="tb-title">我的</view></view>
  <view class="content">
    <view class="mine-hero">
      <view class="mine-avatar">{{avatarText}}</view>
      <view class="mine-name">{{mineName}}</view>
      <view class="mine-sub">已坚持规划 {{mineDays}} 天</view>
    </view>

    <view class="mine-group">
      <view class="mine-item" bindtap="editProfile">
        <view class="mi-icon mi-person"></view><view class="mi-text">修改个人信息</view><view class="mi-arrow">›</view>
      </view>
      <view class="mine-item" bindtap="openTheme">
        <view class="mi-icon mi-theme"></view><view class="mi-text">外观主题</view><view class="mi-arrow">›</view>
      </view>
      <view class="mine-item" bindtap="openRemind">
        <view class="mi-icon mi-bell"></view><view class="mi-text">提醒中心</view><view class="mi-arrow">›</view>
      </view>
      <view class="mine-item" bindtap="openAccount">
        <view class="mi-icon mi-lock"></view><view class="mi-text">账号与安全</view><view class="mi-arrow">›</view>
      </view>
    </view>

    <button class="mine-logout" bindtap="logout">退出登录</button>
  </view>

  <theme-sheet visible="{{themeVisible}}" current="{{themeKey}}" bind:change="onThemeChange" bind:close="onThemeClose" />

  <view wx:if="{{remindVisible}}">
    <view class="sheet-mask" bindtap="closeRemind"></view>
    <view class="sheet-card">
      <view class="edit-title">提醒中心</view>
      <view wx:if="{{reminds.length===0}}" class="empty-hint">近期没有需要提醒的任务</view>
      <view wx:for="{{reminds}}" wx:key="id" class="remind-row">
        <view class="remind-dot" style="background:{{item.catBg}}"></view>
        <view class="remind-main">
          <view class="remind-t">{{item.title}}</view>
          <view class="remind-m">{{item.meta}}</view>
        </view>
      </view>
      <button class="e-cancel" style="width:100%;margin-top:20rpx" bindtap="closeRemind">关闭</button>
    </view>
  </view>

  <view wx:if="{{accountVisible}}">
    <view class="sheet-mask" bindtap="closeAccount"></view>
    <view class="sheet-card">
      <view class="edit-title">账号与安全</view>
      <view class="acc-row" bindtap="logout"><view class="al"><view class="an">退出登录</view></view><view class="aa">›</view></view>
      <view class="acc-row danger" bindtap="delAccount"><view class="al"><view class="an">注销账号</view><view class="as">清空全部数据，不可恢复</view></view><view class="aa">›</view></view>
      <button class="e-cancel" style="width:100%;margin-top:20rpx" bindtap="closeAccount">关闭</button>
    </view>
  </view>
</view>
