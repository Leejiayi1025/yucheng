.login-wrap {
  min-height: 100vh;
  background: var(--body-bg);
  display: flex; flex-direction: column; align-items: center;
  padding: 0 56rpx;
  padding-top: env(safe-area-inset-top);
}
.login-hero { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0 60rpx; }
.login-logo {
  width: 140rpx; height: 140rpx; border-radius: 40rpx;
  background: var(--primary);
  -webkit-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z'/><path fill='black' d='M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z'/></svg>") no-repeat center / 80rpx 80rpx;
  mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z'/><path fill='black' d='M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z'/></svg>") no-repeat center / 80rpx 80rpx;
}
.login-name { font-size: 52rpx; font-weight: 800; color: var(--text); margin-top: 24rpx; }
.login-slogan { font-size: 26rpx; color: var(--text2); margin-top: 10rpx; }

.login-card {
  width: 100%;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,.06);
  border: 1rpx solid rgba(255,255,255,.5);
}
.seg { display: flex; background: var(--primary-soft); border-radius: var(--radius); padding: 8rpx; margin-bottom: 30rpx; }
.seg-item { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 14rpx; font-size: 28rpx; color: var(--text2); }
.seg-item.on { background: var(--solid); color: var(--primary); font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }

.lf { margin-bottom: 24rpx; }
.lf label { display: block; font-size: 24rpx; color: var(--text2); margin-bottom: 10rpx; }
.lf input {
  width: 100%; background: var(--solid); border: 1rpx solid var(--line);
  border-radius: var(--radius-sm); padding: 22rpx 24rpx; font-size: 28rpx; color: var(--text);
}
.login-btn {
  margin-top: 12rpx; height: 96rpx; border-radius: var(--radius);
  background: var(--primary); color: #fff; font-size: 32rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.login-btn::after { border: none; }
.login-tip { text-align: center; font-size: 22rpx; color: var(--text2); margin-top: 22rpx; }
