<view wx:if="{{visible}}">
  <view class="sheet-mask" bindtap="onClose"></view>
  <view class="sheet-card">
    <view class="edit-title">选择外观</view>
    <view class="theme-list">
      <view wx:for="{{list}}" wx:key="key" class="theme-row {{current===item.key?'on':''}}" data-key="{{item.key}}" bindtap="pick">
        <view class="theme-sw">
          <view class="sw-dot" style="background:{{item.bg}}"></view>
          <view class="sw-dot" style="background:{{item.primary}}"></view>
          <view class="sw-dot" style="background:{{item.card}}"></view>
        </view>
        <text class="theme-name">{{item.name}}</text>
        <text wx:if="{{current===item.key}}" class="theme-check">✓</text>
      </view>
    </view>
  </view>
</view>
