/* 语程 全局样式（移植原型设计 token，px→rpx 约 ×2） */
page {
  --bg: #F5F1EC;
  --card: rgba(255, 255, 255, .82);
  --solid: #FFFFFF;
  --primary: #6B8E7B;
  --primary-soft: #E1F0E8;
  --primary-dark: #5A7A6A;
  --text: #3D3D3D;
  --text2: #8E8E93;
  --line: rgba(60, 60, 60, .08);
  --shadow: 0 8rpx 32rpx rgba(60, 60, 60, .08);
  --danger: #C25B4E;
  --body-bg: #E8E0D8;
  --tabbar-bg: rgba(245, 241, 236, .92);
  --tabbar-border: rgba(60, 60, 60, .06);
  --radius-sm: 10rpx;
  --radius: 16rpx;
  --radius-lg: 22rpx;
  --radius-xl: 28rpx;

  background: var(--body-bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, "Microsoft YaHei", Arial, sans-serif;
  font-size: 28rpx;
  min-height: 100%;
}

view, text, scroll-view, input, textarea, button { box-sizing: border-box; }

.page-wrap {
  min-height: 100vh;
  background: var(--body-bg);
  display: flex;
  flex-direction: column;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
  border: 1rpx solid rgba(255, 255, 255, .5);
}

/* 自绘下拉触发器（提醒/分类/顺延通用） */
.rm-sel {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--card);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 56rpx 16rpx 24rpx;
  position: relative;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, .04);
}
.rm-chev {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text2);
  font-size: 24rpx;
}
.rm-menu {
  position: fixed;
  z-index: 60;
  background: var(--solid);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, .18);
  padding: 10rpx;
  max-height: 520rpx;
  overflow-y: auto;
  display: none;
}
.rm-menu.show { display: block; }
.rm-opt {
  position: relative;
  padding: 18rpx 56rpx 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: var(--text);
  white-space: nowrap;
}
.rm-opt.active { background: var(--primary-soft); color: var(--primary); font-weight: 600; }
.rm-opt.active::after { content: '✓'; position: absolute; right: 20rpx; top: 50%; transform: translateY(-50%); font-weight: 700; color: var(--primary); }
.rm-opt.cat-custom-opt { color: var(--primary); font-weight: 600; border: 1rpx dashed var(--primary); margin-top: 8rpx; background: rgba(107, 142, 123, .04); }

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius);
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.btn-primary::after { border: none; }

/* 浮动语音按钮 */
.fab {
  position: fixed;
  right: 44rpx;
  bottom: 160rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(107, 142, 123, .35);
  z-index: 50;
}
.fab .mic { width: 48rpx; height: 48rpx; }

/* 底部自定义 Tab */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 40;
  flex-shrink: 0;
  width: 100%;
  height: 110rpx;
  background: var(--tabbar-bg);
  border-top: 1rpx solid var(--tabbar-border);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: var(--text2);
  font-size: 22rpx;
}
.tab-item.active { color: var(--primary); }
.tab-item .ti {
  width: 44rpx;
  height: 44rpx;
  background-color: var(--text2);
  /* 用 mask 承载图标形状，颜色由 background-color 跟随主题 */
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: 44rpx 44rpx;
  mask-size: 44rpx 44rpx;
}
.tab-item.active .ti { background-color: var(--primary); }
.ti-today { -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z'/></svg>"); mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z'/></svg>"); }
.ti-cal { -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z'/></svg>"); mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z'/></svg>"); }
.ti-mine { -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/></svg>"); mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/></svg>"); }

/* ===== 跨页共享：区块标题 / 空态 / 备注 ===== */
.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}
.sec-title .st-left { font-size: 30rpx; font-weight: 700; color: var(--text); }
.sec-title .count {
  display: inline-block;
  min-width: 34rpx;
  text-align: center;
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--text2);
  background: var(--primary-soft);
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
}
.sec-title .st-add {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--primary);
}
.empty-hint {
  text-align: center;
  color: var(--text2);
  font-size: 26rpx;
  padding: 28rpx 0 40rpx;
}
.card-note {
  font-size: 23rpx;
  color: var(--text2);
  margin-top: 6rpx;
  line-height: 1.4;
}
/* 通用底部弹层（edit-sheet / voice-sheet / theme-sheet 共用） */
.sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .4);
  z-index: 80;
}
.sheet-card {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--card);
  backdrop-filter: blur(10px);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, .15);
  z-index: 81;
  max-height: 88vh;
  overflow-y: auto;
}
.edit-title { font-size: 32rpx; font-weight: 700; color: var(--text); margin-bottom: 20rpx; }
.edit-field { margin-bottom: 22rpx; }
.edit-field > label { display: block; font-size: 24rpx; color: var(--text2); margin-bottom: 10rpx; }
.edit-field input, .edit-field textarea, .vm-f input, .vm-f textarea {
  width: 100%;
  background: var(--solid);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: var(--text);
}
.edit-field textarea, .vm-f textarea { height: 130rpx; }
.f-row2 { display: flex; gap: 18rpx; }
.f-row2 .edit-field { flex: 1; }
.edit-actions { display: flex; gap: 18rpx; margin-top: 8rpx; }
.e-cancel, .e-save, .e-del, .e-confirm {
  flex: 1; height: 88rpx; border-radius: var(--radius);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 600; border: none;
}
.e-cancel { background: var(--solid); color: var(--text2); border: 1rpx solid var(--line); }
.e-save { background: var(--primary); color: #fff; }
.e-del { flex: 0 0 88rpx; background: var(--solid); color: var(--danger); border: 1rpx solid var(--danger); }
.e-confirm { background: var(--danger); color: #fff; }
.e-cancel::after, .e-save::after, .e-del::after, .e-confirm::after { border: none; }
